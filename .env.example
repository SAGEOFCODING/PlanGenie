# GenAI-Powered Event Planning Assistant Configuration
# Copy this file to .env and provide your API keys if available.
# The application automatically falls back to an intelligent offline planning engine if no key is provided.

# Flask settings
FLASK_ENV=production
FLASK_SECRET_KEY=replace-with-a-random-secret-key-for-sessions
PORT=5000

# GenAI Model Provider Configuration (Optional)
# Supported options: "gemini" (default) or "openai"
AI_PROVIDER=gemini

# Google Gemini API Key (Optional)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative Optional Provider)
OPENAI_API_KEY=your_openai_api_key_here
